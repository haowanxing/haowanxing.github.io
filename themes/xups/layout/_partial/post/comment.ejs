<% if (theme.comment.enable) { %>
  <div id="comments" class="comment">
    <script src="https://giscus.app/client.js"
            data-repo="<%- theme.comment.repo %>"
            data-repo-id="<%- theme.comment.repo_id %>"
            data-category="<%- theme.comment.category %>"
            data-category-id="<%- theme.comment.category_id %>"
            data-mapping="<%- theme.comment.mapping %>"
            data-strict="<%- theme.comment.strict %>"
            data-reactions-enabled="<%- theme.comment.reactions_enabled %>"
            data-emit-metadata="<%- theme.comment.emit_metadata %>"
            data-input-position="<%- theme.comment.input_position %>"
            data-theme="<%- theme.comment.theme %>"
            data-lang="<%- theme.comment.lang %>"
            crossorigin="anonymous"
            async>
    </script>
  </div>
<% } %>
